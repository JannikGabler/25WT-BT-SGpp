+// Copyright (C) 2008-today The SG++ project
+// This file is part of the SG++ project. For conditions of distribution and
+// use, please see the copyright notice provided with SG++ or at
+// sgpp.sparsegrids.org
+
+/**
+ * @file thread_scratch.hpp
+ * @brief Per-thread scratch objects of the source-function evaluators that stay correct when an
+ * evaluation calls another one (@c misc::withThreadScratch).
+ */
+#pragma once
+
+namespace sgpp {
+namespace combigrid {
+namespace misc {
+
+/**
+ * @brief Calls @p use(scratch) with a per-thread object of type @p T (one per @p Tag), reused
+ * across calls; inside a nested call (a callable that evaluates another source function with the
+ * same scratch) it passes a new object instead, so that the outer one is not overwritten.
+ * @tparam T   Type of the scratch object (default-constructible).
+ * @tparam Tag Distinguishes the scratch objects of different users.
+ * @param use  Callable taking a @c T&.
+ */
+template <typename T, typename Tag, typename Use>
+void withThreadScratch(Use&& use) {
+  thread_local T scratch;
+  thread_local bool busy = false;
+
+  if (busy) {
+    T local;
+    use(local);
+    return;
+  }
+
+  busy = true;
+  try {
+    use(scratch);
+  } catch (...) {
+    busy = false;
+    throw;
+  }
+  busy = false;
+}
+
+}  // namespace misc
+}  // namespace combigrid
+}  // namespace sgpp
