+// sgpp.sparsegrids.org
+
+/**
+ * @file cached_source_func_evaluator.hpp
+ * @brief Evaluator that looks every point up in a @c SourceFuncCache
+ * (@c misc::CachedSourceFuncEvaluator).
+ */
+#pragma once
+
+#include <cstddef>
+#include <memory>
+#include <sgpp/base/datatypes/DataMatrix.hpp>
+#include <sgpp/base/datatypes/DataVector.hpp>
+#include <sgpp/combigrid/miscellaneous/source_function_evaluation/point_block.hpp>
+#include <sgpp/combigrid/miscellaneous/source_function_evaluation/source_func_evaluator.hpp>
+
+namespace sgpp {
+namespace combigrid {
+
+class SourceFuncCache;
+
+namespace misc {
+
+class BoostPointValueTable;
+
+/**
+ * @brief Evaluator of the cached source functions (@c CachedSourceFunc,
+ * @c CachedVectorSourceFunc) with the policies MemoryOnly, TemporaryStorage and
+ * PersistentStorage: looks the points up in the cache and evaluates the wrapped evaluator only at
+ * the points the cache does not hold.
+ *
+ * A block (or a matrix of points) is looked up point by point; its misses are evaluated in one
+ * call of the wrapped evaluator (one call of a batch callable; one acquisition of the GIL for a
+ * Python callable) and then stored, unless one of their values is NaN. Points of another
+ * dimension than the cache's bypass it.
+ */
+class CachedSourceFuncEvaluator final : public SourceFuncEvaluator {
+ public:
+  /**
+   * @brief Returns the evaluator of a cached function: this one, or the one of the adaptive
+   * policy (@c AdaptiveCachedSourceFuncEvaluator).
+   * @param inner    Evaluator of the wrapped function.
+   * @param cache    Cache (not null).
+   * @param nOutputs Number of values per point m (at least 1).
+   * @throws std::invalid_argument if @p nOutputs is 0, @p cache is null or holds the values of a
+   * function with another number of outputs.
+   */
+  static std::unique_ptr<SourceFuncEvaluator> create(std::unique_ptr<SourceFuncEvaluator> inner,
+                                                     const std::shared_ptr<SourceFuncCache>& cache,
+                                                     size_t nOutputs);
+
+  /**
+   * @brief Wraps @p inner.
+   * @param inner    Evaluator of the wrapped function.
+   * @param cache    Cache (not null, attached).
+   * @param nOutputs Number of values per point m.
+   */
+  CachedSourceFuncEvaluator(std::unique_ptr<SourceFuncEvaluator> inner,
+                            std::shared_ptr<SourceFuncCache> cache, size_t nOutputs);
+
+  std::unique_ptr<SourceFuncEvaluator> clone() const override;
+
+  void evaluate(const base::DataVector& point, double* values) const override;
+
+  void evaluateBlock(const PointBlock& block, double* values) const override;
+
+  void evaluatePoints(const base::DataMatrix& points, double* values) const override;
+
+ private:
+  /**
+   * @brief Looks the points that @p forEachPoint visits up in @p table and evaluates the misses
+   * in one call.
+   * @param table        The table of the cache.
+   * @param forEachPoint Calls its argument with every point, in order.
+   * @param values       Output: the values of the points (m per point).
+   */
+  template <typename ForEachPoint>
+  void lookUp(BoostPointValueTable& table, ForEachPoint&& forEachPoint, double* values) const;
+
+  std::unique_ptr<SourceFuncEvaluator> inner_;  ///< Evaluator of the wrapped function.
+  std::shared_ptr<SourceFuncCache> cache_;      ///< The cache (shared with all copies).
+  size_t nOutputs_;                             ///< Number of values per point m.
+};
+
