+/// A 4-dimensional block: rows along dimension 2 (3 nodes), outer dimensions 0 (2 nodes) and 3
+/// (3 nodes); dimension 1 is fixed at 0.5.
+struct BlockFixture {
+  DataVector point{9.0, 0.5, 9.0, 9.0};
+  std::vector<size_t> outerDims{0, 3};
+  std::vector<GPCntType> nOuterNodes{2, 3};
+  std::vector<double> rowNodes{0.1, 0.2, 0.3};
+  std::vector<double> nodes0{-1.0, -2.0};
+  std::vector<double> nodes3{10.0, 20.0, 30.0};
+  std::vector<const double*> outerNodes{nodes0.data(), nodes3.data()};
+
+  PointBlock block() {
+    return PointBlock{
+        point, 2, rowNodes.data(), 3, 2, outerDims.data(), nOuterNodes.data(), outerNodes.data()};
+  }
+
+  /// The points of the block in its order.
+  std::vector<DataVector> expected() const {
+    std::vector<DataVector> points;
+    for (const double x3 : nodes3) {
+      for (const double x0 : nodes0) {
+        for (const double x2 : rowNodes) points.push_back(DataVector{x0, 0.5, x2, x3});
+      }
+    }
+    return points;
+  }
+};
