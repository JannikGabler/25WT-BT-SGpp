+BOOST_AUTO_TEST_CASE(cached_batch_with_hits_misses_and_nan) {
+  if (!cacheAvailable()) return;
+  // Points with x0 > 0.42 give NaN (never stored); every third point is looked up beforehand.
+  std::vector<size_t> batchSizes;  // One entry per evaluated point: the size of its batch
+  const auto func = [&batchSizes](const DataMatrix& points, const std::span<double> values) {
+    for (size_t row = 0; row < points.getNrows(); row++) {
+      batchSizes.push_back(points.getNrows());
+      const double x0 = points.get(row, 0);
+      values[row] = (x0 > 0.42) ? std::numeric_limits<double>::quiet_NaN() : x0 * x0;
+    }
+  };
+  const auto isNaNPoint = [](const double x0) { return x0 > 0.42; };
+  const CachedSourceFunc f{SourceFunc::BatchFunc(func)};
+  const size_t nPoints = 12;
+  DataMatrix points(nPoints, 2);
+  DataMatrix warm(nPoints / 3, 2);
+  size_t nStoredWarm = 0;
+  for (size_t row = 0; row < nPoints; row++) {
+    points.set(row, 0, 0.05 * static_cast<double>(row + 1));
+    points.set(row, 1, 0.25);
+    if (row % 3 == 0) {
+      warm.set(row / 3, 0, points.get(row, 0));
+      warm.set(row / 3, 1, 0.25);
+      nStoredWarm += isNaNPoint(points.get(row, 0)) ? 0 : 1;
+    }
+  }
+  size_t nNaN = 0;
+  for (size_t row = 0; row < nPoints; row++) nNaN += isNaNPoint(points.get(row, 0)) ? 1 : 0;
+  std::vector<double> values(nPoints);
+  f.evaluate(warm, std::span<double>(values.data(), nPoints / 3));
+  BOOST_CHECK_EQUAL(f.statistics().entries, nStoredWarm);
+
+  // Hits, misses and NaN values in one matrix: the misses are evaluated in one batch
+  batchSizes.clear();
+  f.evaluate(points, values);
+  const size_t nMisses = nPoints - nStoredWarm;
+  BOOST_CHECK_EQUAL(batchSizes.size(), nMisses);
+  BOOST_CHECK(std::ranges::all_of(batchSizes, [nMisses](size_t n) { return n == nMisses; }));
+  for (size_t row = 0; row < nPoints; row++) {
+    const double x0 = points.get(row, 0);
+    if (isNaNPoint(x0)) {
+      BOOST_CHECK(std::isnan(values[row]));
+    } else {
+      BOOST_CHECK_EQUAL(values[row], x0 * x0);
+    }
+  }
+  BOOST_CHECK_EQUAL(f.statistics().entries, nPoints - nNaN);
+
+  // Only the NaN points are evaluated again, in one batch
+  batchSizes.clear();
+  f.evaluate(points, values);
+  BOOST_CHECK_EQUAL(batchSizes.size(), nNaN);
+  BOOST_CHECK(std::ranges::all_of(batchSizes, [nNaN](size_t n) { return n == nNaN; }));
+  BOOST_CHECK_EQUAL(f.statistics().entries, nPoints - nNaN);
+}
