+// Copyright (C) 2008-today The SG++ project
+// This file is part of the SG++ project. For conditions of distribution and
+// use, please see the copyright notice provided with SG++ or at
+// sgpp.sparsegrids.org
+
+#include <algorithm>
+#include <memory>
+#include <sgpp/base/datatypes/DataMatrix.hpp>
+#include <sgpp/base/datatypes/DataVector.hpp>
+#include <sgpp/combigrid/miscellaneous/source_function_evaluation/batch_source_func_evaluator.hpp>
+#include <sgpp/combigrid/miscellaneous/source_function_evaluation/point_block.hpp>
+#include <sgpp/combigrid/miscellaneous/source_function_evaluation/thread_scratch.hpp>
+#include <span>
+#include <utility>
+
+namespace sgpp {
+namespace combigrid {
+namespace misc {
+
+namespace {
+
+/// Tag of the per-thread matrix of the points passed to the batch callable (reused).
+struct BatchPointsTag;
+
+}  // namespace
+
+BatchSourceFuncEvaluator::BatchSourceFuncEvaluator(BatchFunc func, const size_t nOutputs)
+    : func_(std::move(func)), nOutputs_(nOutputs) {}
+
+std::unique_ptr<SourceFuncEvaluator> BatchSourceFuncEvaluator::clone() const {
+  return std::make_unique<BatchSourceFuncEvaluator>(*this);
+}
+
+void BatchSourceFuncEvaluator::evaluate(const base::DataVector& point, double* const values) const {
+  withThreadScratch<base::DataMatrix, BatchPointsTag>([&](base::DataMatrix& points) {
+    points.resizeRowsCols(1, point.size());
+    std::copy(point.begin(), point.end(), points.data());
+    func_(points, std::span<double>(values, nOutputs_));
+  });
+}
+
+void BatchSourceFuncEvaluator::evaluateBlock(const PointBlock& block, double* const values) const {
+  const size_t nPoints = block.nPoints();
+  const size_t nDim = block.point.size();
+
+  withThreadScratch<base::DataMatrix, BatchPointsTag>([&](base::DataMatrix& points) {
+    points.resizeRowsCols(nPoints, nDim);
+    double* row = points.data();
+    forEachPointOfBlock(block, [&row, nDim](const base::DataVector& point) {
+      std::copy_n(point.data(), nDim, row);
+      row += nDim;
+    });
+    func_(points, std::span<double>(values, nPoints * nOutputs_));
+  });
+}
+
+void BatchSourceFuncEvaluator::evaluatePoints(const base::DataMatrix& points,
+                                              double* const values) const {
+  func_(points, std::span<double>(values, points.getNrows() * nOutputs_));
+}
+
