+}  // namespace combigrid
+}  // namespace sgpp
diff --git a/combigrid/src/sgpp/combigrid/miscellaneous/source_function_evaluation/cache_miss_batch.hpp b/combigrid/src/sgpp/combigrid/miscellaneous/source_function_evaluation/cache_miss_batch.hpp
