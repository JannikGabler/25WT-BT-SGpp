+BOOST_AUTO_TEST_CASE(visits_the_tensor_product_in_order) {
+  BlockFixture fixture;
+  const PointBlock block = fixture.block();
+  std::vector<DataVector> visited;
+  sgpp::combigrid::misc::forEachPointOfBlock(
+      block, [&visited](const DataVector& point) { visited.push_back(point); });
+
+  BOOST_CHECK_EQUAL(block.nPoints(), 18u);
+  BOOST_REQUIRE_EQUAL(visited.size(), 18u);
+  const std::vector<DataVector> expected = fixture.expected();
+  for (size_t p = 0; p < visited.size(); p++) {
+    BOOST_CHECK(visited[p] == expected[p]);
+  }
+
+  // A single row (no outer dimensions) and a single point
+  PointBlock row = block;
+  row.nOuterDims = 0;
+  visited.clear();
+  sgpp::combigrid::misc::forEachPointOfBlock(
+      row, [&visited](const DataVector& point) { visited.push_back(point); });
+  BOOST_CHECK_EQUAL(visited.size(), 3u);
+  BOOST_CHECK_EQUAL(visited[2][2], 0.3);
+  row.nRowNodes = 1;
+  BOOST_CHECK_EQUAL(row.nPoints(), 1u);
+}
