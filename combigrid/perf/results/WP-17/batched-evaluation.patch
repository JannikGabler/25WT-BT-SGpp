+/*******************************************************************************
+Batched source-function evaluation: the same integrand in three forms
+*******************************************************************************/
+
+/// perf::expSum for many points at once (one point per row), point by point: the same floats as
+/// expSum; the batch form costs the copy of the block into the matrix and saves one call per
+/// point (with scalar libm exp, there is nothing to vectorize across the points).
+void expSumBatch(const sgpp::base::DataMatrix& points, const std::span<double> values) {
+  const size_t nDim = points.getNcols();
+  for (size_t p = 0; p < points.getNrows(); p++) {
+    const double* const x = points.data() + p * nDim;
+    double sum = 0.0;
+    for (size_t k = 0; k < nDim; k++) sum += x[k];
+    values[p] = std::exp(0.5 * sum);
+  }
+}
+
+/**
+ * The whole quadrature operator (SG or DSG, as the e2e case quad/<grid>/<nodes>-exp/...) with
+ * perf::expSum as function pointer (micro/batch/<grid>/<cfg>/fnptr, as the e2e suite), as lambda
+ * (/lambda: inlined into the evaluation of a block) and as batch callable expSumBatch (/batch).
+ * Counter result: the quadrature value (equal for the three forms at 1 thread).
+ */
+template <typename Grid>
+void addBatchForms(Suite& suite, const std::string& gridName, const std::string& nodes,
+                   const LvlType boundary, const size_t nDim, const LvlType maxLvl) {
+  const std::vector<std::pair<std::string, std::function<SourceFunc()>>> forms{
+      {"fnptr", []() { return SourceFunc(&perf::expSum); }},
+      {"lambda", []() { return SourceFunc([](const DataVector& x) { return perf::expSum(x); }); }},
+      {"batch", []() { return SourceFunc(SourceFunc::BatchFunc(expSumBatch)); }}};
+  for (const auto& [form, make] : forms) {
+    suite.addMicro(
+        "micro/batch/" + gridName + "/" + cfg(nodes, boundary, nDim, maxLvl) + "/" + form,
+        [=](MicroRun& run) {
+          CompleteSGGenInstr genInstr(maxLvl, nDim);
+          perf::configure(genInstr, nodes, boundary, perf::unitDomain(nDim));
+          const Grid grid(genInstr);
+          const SourceFunc sourceFunc = make();
+          size_t nGP = 0;
+          for (const TensorGridCTData& tgData : grid) nGP += tgData.tensorGrid.nGP();
+
+          run.setItems(static_cast<double>(nGP));
+          run.setCounter("result", cg::quadrature(sourceFunc, grid));
+          run.measure([&]() { doNotOptimize(cg::quadrature(sourceFunc, grid)); });
+        });
+  }
+}
+
