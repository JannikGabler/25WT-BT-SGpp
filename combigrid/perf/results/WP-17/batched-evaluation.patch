+// Creates a cached source function (Cached = CachedSourceFunc or CachedVectorSourceFunc, Base its
+// base class) around a PyEvaluator and registers it under its base pointer; extra are the
+// arguments after the evaluator (CachedSourceFunc: the cache; CachedVectorSourceFunc: nOutputs and
+// the cache).
+template <typename Cached, typename Base, typename... Extra>
+Cached* newCachedSourceFunc(PyObject* pyfunc, size_t nOutputs, bool vector, bool batch,
+                            Extra&&... extra) {
+  auto holder = std::make_shared<PyCallableHolder>(pyfunc);
+  auto* sourceFunc = new Cached(std::make_unique<PyEvaluator>(holder, nOutputs, vector, batch),
+                                std::forward<Extra>(extra)...);
+  registerSourceFunc(static_cast<const Base*>(sourceFunc), std::move(holder));
+  return sourceFunc;
+}
