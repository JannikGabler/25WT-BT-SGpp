+#include <sgpp/combigrid/miscellaneous/source_function_evaluation/thread_scratch.hpp>
+#include <span>
+#include <type_traits>
+#include <utility>
+
+namespace sgpp {
+namespace combigrid {
+namespace misc {
+
+/**
+ * @brief Evaluator of a callable that takes one point: @c double(const base::DataVector&)
+ * (scalar, m = 1) or @c void(const base::DataVector&, std::span<double>) (m values).
+ *
+ * Instantiated where the source function is constructed, with the type of the callable: a block
+ * is one loop over its points that calls the callable directly (inlined for a lambda, one
+ * indirect call for a function pointer, the call of a @c std::function for a @c std::function).
+ * The callable is called as non-const lvalue, as @c std::function does (a mutable lambda keeps
+ * its state across calls).
+ *
+ * @tparam Func Type of the callable (copyable).
+ */
+template <typename Func>
+class PointwiseSourceFuncEvaluator final : public SourceFuncEvaluator {
+ public:
+  /// @brief Whether the callable returns the value (scalar) instead of writing m values.
+  static constexpr bool SCALAR = std::is_invocable_r_v<double, Func&, const base::DataVector&>;
+
+  /**
+   * @brief Wraps @p func.
+   * @param func     Callable.
+   * @param nOutputs Number of values per point m (1 for a scalar callable).
+   */
+  PointwiseSourceFuncEvaluator(Func func, const size_t nOutputs)
+      : func_(std::move(func)), nOutputs_(nOutputs) {}
+
+  std::unique_ptr<SourceFuncEvaluator> clone() const override {
+    return std::make_unique<PointwiseSourceFuncEvaluator>(*this);
+  }
+
+  void evaluate(const base::DataVector& point, double* const values) const override {
+    if constexpr (SCALAR) {
+      *values = func_(point);
+    } else {
+      func_(point, std::span<double>(values, nOutputs_));
+    }
+  }
+
+  void evaluateBlock(const PointBlock& block, double* const values) const override {
+    double* out = values;
+
+    if constexpr (SCALAR) {
+      forEachPointOfBlock(block, [this, &out](const base::DataVector& point) {
+        *out = func_(point);
+        out++;
+      });
+    } else {
+      const size_t nOutputs = nOutputs_;
+      forEachPointOfBlock(block, [this, &out, nOutputs](const base::DataVector& point) {
+        func_(point, std::span<double>(out, nOutputs));
+        out += nOutputs;
+      });
+    }
+  }
+
+  void evaluatePoints(const base::DataMatrix& points, double* const values) const override {
+    const size_t nCols = points.getNcols();
+
+    // The rows are copied into a per-thread DataVector (the callable takes one)
+    withThreadScratch<base::DataVector, PointwiseSourceFuncEvaluator>([&](base::DataVector& point) {
+      point.resize(nCols);
+      for (size_t row = 0; row < points.getNrows(); row++) {
+        std::copy_n(points.data() + row * nCols, nCols, point.data());
+        evaluate(point, values + row * nOutputs_);
+      }
+    });
+  }
+
+ private:
+  mutable Func func_;  ///< The callable (non-const call, as with @c std::function).
+  size_t nOutputs_;    ///< Number of values per point m.
+};
+
