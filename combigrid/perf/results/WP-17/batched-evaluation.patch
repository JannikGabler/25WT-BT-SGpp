+// sgpp.sparsegrids.org
+
+/**
+ * @file adaptive_cached_source_func_evaluator.hpp
+ * @brief Evaluator of a cached source function with @c CachePolicy::Adaptive
+ * (@c misc::AdaptiveCachedSourceFuncEvaluator).
+ */
+#pragma once
+
+#include <cstddef>
+#include <memory>
+#include <sgpp/base/datatypes/DataMatrix.hpp>
+#include <sgpp/base/datatypes/DataVector.hpp>
+#include <sgpp/combigrid/functions/source_functions/caching/adaptive_cache_mode.hpp>
+#include <sgpp/combigrid/miscellaneous/source_function_evaluation/point_block.hpp>
+#include <sgpp/combigrid/miscellaneous/source_function_evaluation/source_func_evaluator.hpp>
+
+namespace sgpp {
+namespace combigrid {
+
+class SourceFuncCache;
+
+namespace misc {
+
+class AdaptiveCacheController;
+class BoostPointValueTable;
+
+/**
+ * @brief Evaluator of the cached source functions with the adaptive policy: reads the mode of
+ * the controller once per block (or point); in mode None it passes the block to the wrapped
+ * evaluator, else every point takes the path of the policy (memory hits inline, misses and timed
+ * points through @c SourceFuncCache::evaluateAdaptive, which evaluates the wrapped evaluator at
+ * the point).
+ */
+class AdaptiveCachedSourceFuncEvaluator final : public SourceFuncEvaluator {
+ public:
+  /**
+   * @brief Wraps @p inner.
+   * @param inner    Evaluator of the wrapped function.
+   * @param cache    Cache with the adaptive policy (not null, attached).
+   * @param nOutputs Number of values per point m.
+   */
+  AdaptiveCachedSourceFuncEvaluator(std::unique_ptr<SourceFuncEvaluator> inner,
+                                    std::shared_ptr<SourceFuncCache> cache, size_t nOutputs);
+
+  std::unique_ptr<SourceFuncEvaluator> clone() const override;
+
+  void evaluate(const base::DataVector& point, double* values) const override;
+
+  void evaluateBlock(const PointBlock& block, double* values) const override;
+
+  void evaluatePoints(const base::DataMatrix& points, double* values) const override;
+
+ private:
+  /**
+   * @brief Returns the table to look points with @p nDim coordinates up in, or nullptr if they
+   * bypass the cache (mode None or another dimension).
+   * @param mode The mode read by the caller.
+   */
+  BoostPointValueTable* table(AdaptiveCacheMode mode, size_t nDim) const;
+
+  /// @brief Evaluates one point in a mode other than None (the path of the policy).
+  void evaluateCached(BoostPointValueTable& table, AdaptiveCacheMode mode,
+                      const base::DataVector& point, double* values) const;
+
+  std::unique_ptr<SourceFuncEvaluator> inner_;  ///< Evaluator of the wrapped function.
+  std::shared_ptr<SourceFuncCache> cache_;      ///< The cache (shared with all copies).
+  const AdaptiveCacheController* controller_;   ///< The controller of the cache.
+  size_t nOutputs_;                             ///< Number of values per point m.
+};
+
