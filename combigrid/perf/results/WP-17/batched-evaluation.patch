+  BOOST_CHECK_EQUAL(blockOuterDimsCnt(threes.data(), 7), 4u);
+  BOOST_CHECK_EQUAL(blockRowsCnt(threes.data(), 4), 81u);
+  BOOST_CHECK_EQUAL(blockOuterDimsCnt(threes.data(), 3), 2u);  // all dimensions fit
+  BOOST_CHECK_EQUAL(blockOuterDimsCnt(threes.data(), 1), 0u);
+  BOOST_CHECK_EQUAL(blockRowPieceLength(3), 3u);
+
+  const std::vector<GPCntType> longRow{MAX_BLOCK_POINTS + 1, 3};
+  BOOST_CHECK_EQUAL(blockOuterDimsCnt(longRow.data(), 2), 0u);
+  BOOST_CHECK_EQUAL(blockRowsCnt(longRow.data(), 0), 1u);
+  BOOST_CHECK_EQUAL(blockRowPieceLength(MAX_BLOCK_POINTS + 1), MAX_BLOCK_POINTS);
+
+  const std::vector<GPCntType> exact{MAX_BLOCK_POINTS / 2, 2, 2};
+  BOOST_CHECK_EQUAL(blockOuterDimsCnt(exact.data(), 3), 1u);
+}
