+BOOST_AUTO_TEST_CASE(nested_evaluation_inside_a_batch_callable) {
+  // The batch callable evaluates another batch source function on the same thread: the
+  // per-thread matrices of the evaluators must not be shared between the two calls.
+  const SourceFunc inner{SourceFunc::BatchFunc(scalarBatch)};
+  const SourceFunc outer(
+      SourceFunc::BatchFunc([&inner](const DataMatrix& points, const std::span<double> values) {
+        DataMatrix shifted(points);
+        for (size_t i = 0; i < shifted.size(); i++) shifted[i] += 1.0;
+        inner.evaluate(shifted, values);
+        for (size_t row = 0; row < points.getNrows(); row++) {
+          DataVector point(points.getNcols());
+          points.getRow(row, point);
+          values[row] += inner.evaluate(point);  // a matrix of one row, nested
+        }
+      }));
+  BlockFixture fixture;
+  std::vector<double> values(18);
+  outer.evaluateBlock(fixture.block(), values.data());
+  const std::vector<DataVector> points = fixture.expected();
+  for (size_t p = 0; p < points.size(); p++) {
+    DataVector shifted(points[p]);
+    for (double& x : shifted) x += 1.0;
+    BOOST_CHECK_EQUAL(values[p], scalarFunc(shifted) + scalarFunc(points[p]));
+  }
+}
