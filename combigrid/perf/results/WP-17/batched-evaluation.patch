+// use, please see the copyright notice provided with SG++ or at
+// sgpp.sparsegrids.org
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <memory>
+#include <sgpp/combigrid/functions/source_functions/caching/source_function_cache.hpp>
+#include <sgpp/combigrid/miscellaneous/caching/boost_point_value_table/boost_point_value_table.hpp>
+#include <sgpp/combigrid/miscellaneous/source_function_evaluation/adaptive_cached_source_func_evaluator.hpp>
+#include <sgpp/combigrid/miscellaneous/source_function_evaluation/cache_miss_batch.hpp>
+#include <sgpp/combigrid/miscellaneous/source_function_evaluation/cached_source_func_evaluator.hpp>
+#include <sgpp/combigrid/miscellaneous/source_function_evaluation/thread_scratch.hpp>
+#include <span>
+#include <stdexcept>
+#include <utility>
+
+namespace sgpp {
+namespace combigrid {
+namespace misc {
+
+std::unique_ptr<SourceFuncEvaluator> CachedSourceFuncEvaluator::create(
+    std::unique_ptr<SourceFuncEvaluator> inner, const std::shared_ptr<SourceFuncCache>& cache,
+    const size_t nOutputs) {
+  if (nOutputs == 0) {
+    throw std::invalid_argument("The number of outputs must be at least 1");
+  }
+  if (cache == nullptr) {
+    throw std::invalid_argument("The cache must not be null");
+  }
+  cache->attach(nOutputs);
+  if (cache->adaptiveController() != nullptr) {
+    return std::make_unique<AdaptiveCachedSourceFuncEvaluator>(std::move(inner), cache, nOutputs);
+  }
+
+  return std::make_unique<CachedSourceFuncEvaluator>(std::move(inner), cache, nOutputs);
+}
+
+CachedSourceFuncEvaluator::CachedSourceFuncEvaluator(std::unique_ptr<SourceFuncEvaluator> inner,
+                                                     std::shared_ptr<SourceFuncCache> cache,
+                                                     const size_t nOutputs)
+    : inner_(std::move(inner)), cache_(std::move(cache)), nOutputs_(nOutputs) {}
+
+std::unique_ptr<SourceFuncEvaluator> CachedSourceFuncEvaluator::clone() const {
+  return std::make_unique<CachedSourceFuncEvaluator>(inner_->clone(), cache_, nOutputs_);
+}
+
+void CachedSourceFuncEvaluator::evaluate(const base::DataVector& point,
+                                         double* const values) const {
+  BoostPointValueTable* const table = cache_->table(point.size());
+  if (table == nullptr) {
+    inner_->evaluate(point, values);  // another dimension
+    return;
+  }
+
+  table->lookUpOrEvaluate(point, std::span<double>(values, nOutputs_),
+                          [this](const base::DataVector& p, const std::span<double> out) {
+                            inner_->evaluate(p, out.data());
+                          });
+}
+
+void CachedSourceFuncEvaluator::evaluateBlock(const PointBlock& block, double* const values) const {
+  BoostPointValueTable* const table = cache_->table(block.point.size());
+  if (table == nullptr) {
+    inner_->evaluateBlock(block, values);
+    return;
+  }
+
+  lookUp(*table, [&block](auto&& visit) { forEachPointOfBlock(block, visit); }, values);
+}
+
+void CachedSourceFuncEvaluator::evaluatePoints(const base::DataMatrix& points,
+                                               double* const values) const {
+  BoostPointValueTable* const table = cache_->table(points.getNcols());
+  if (table == nullptr) {
+    inner_->evaluatePoints(points, values);
+    return;
+  }
+
+  lookUp(
+      *table,
+      [&points](auto&& visit) {
+        base::DataVector point(points.getNcols());
+        for (size_t row = 0; row < points.getNrows(); row++) {
+          points.getRow(row, point);
+          visit(static_cast<const base::DataVector&>(point));
+        }
+      },
+      values);
+}
+
+namespace {
+
+/// Tag of the per-thread miss batch of the cached evaluators.
+struct CacheMissBatchTag;
+
+}  // namespace
+
+template <typename ForEachPoint>
+void CachedSourceFuncEvaluator::lookUp(BoostPointValueTable& table, ForEachPoint&& forEachPoint,
+                                       double* const values) const {
+  const size_t nOutputs = nOutputs_;
+
+  withThreadScratch<CacheMissBatch, CacheMissBatchTag>([&](CacheMissBatch& misses) {
+    misses.reset(table.nDim(), nOutputs);
+    size_t idx = 0;
+
+    // Hits are written directly, misses collected
+    forEachPoint([&](const base::DataVector& point) {
+      const uint64_t hash = BoostPointValueTable::hash(point.data(), point.size());
+      double* const out = values + idx * nOutputs;
+      if (!table.find(point.data(), hash, out) &&
+          !(table.onDisk() && table.findOnDisk(point.data(), hash, out))) {
+        misses.add(point.data(), idx, hash);
+      }
+      idx++;
+    });
+
+    if (misses.size() == 0) {
+      return;
+    }
+
+    misses.values.resize(misses.size() * nOutputs);
+    inner_->evaluatePoints(misses.points, misses.values.data());
+
+    for (size_t miss = 0; miss < misses.size(); miss++) {
+      const double* const missValues = misses.values.data() + miss * nOutputs;
+      std::copy_n(missValues, nOutputs, values + misses.indices[miss] * nOutputs);
+      if (std::none_of(missValues, missValues + nOutputs,
+                       [](const double value) { return std::isnan(value); })) {
+        table.insert(misses.points.data() + miss * table.nDim(), misses.hashes[miss], missValues);
+      }
+    }
+  });
+}
+
+}  // namespace misc
+}  // namespace combigrid
+}  // namespace sgpp
