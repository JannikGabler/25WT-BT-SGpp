+constexpr size_t N_OUTPUTS = 3;
+
+double scalarFunc(const DataVector& x) {
+  double sum = 0.0;
+  for (size_t k = 0; k < x.size(); k++) sum += static_cast<double>(k + 1) * x[k];
+  return std::exp(0.3 * sum) + std::sin(x[0]);
+}
+
+void vectorFunc(const DataVector& x, const std::span<double> out) {
+  for (size_t k = 0; k < out.size(); k++) out[k] = static_cast<double>(k + 1) * scalarFunc(x);
+}
+
+/// The per-point functions row by row (the same floats).
+void scalarBatch(const DataMatrix& points, const std::span<double> values) {
+  DataVector point(points.getNcols());
+  for (size_t row = 0; row < points.getNrows(); row++) {
+    points.getRow(row, point);
+    values[row] = scalarFunc(point);
+  }
+}
+
+void vectorBatch(const DataMatrix& points, const std::span<double> values) {
+  DataVector point(points.getNcols());
+  for (size_t row = 0; row < points.getNrows(); row++) {
+    points.getRow(row, point);
+    vectorFunc(point, values.subspan(row * N_OUTPUTS, N_OUTPUTS));
+  }
+}
