+// Copyright (C) 2008-today The SG++ project
+// This file is part of the SG++ project. For conditions of distribution and
+// use, please see the copyright notice provided with SG++ or at
+// sgpp.sparsegrids.org
+
+/**
+ * @file cache_miss_batch.hpp
+ * @brief The points of a block that a cache misses (@c misc::CacheMissBatch).
+ */
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <sgpp/base/datatypes/DataMatrix.hpp>
+#include <vector>
+
+namespace sgpp {
+namespace combigrid {
+namespace misc {
+
+/**
+ * @brief The points of a block (or of the rows of a matrix) that the cache does not hold: they
+ * are evaluated in one call of the wrapped evaluator, then stored. Per thread, reused.
+ */
+struct CacheMissBatch {
+  /// @brief Clears the batch for points with @p nDim coordinates and @p nOutputs values.
+  void reset(const size_t nDim, const size_t nOutputs) {
+    points.resizeRowsCols(0, nDim);
+    indices.clear();
+    hashes.clear();
+    this->nOutputs = nOutputs;
+  }
+
+  /// @brief Appends a point (its index in the block and its hash).
+  void add(const double* const point, const size_t index, const uint64_t hash) {
+    const size_t nDim = points.getNcols();
+    points.resizeRowsCols(points.getNrows() + 1, nDim);
+    std::copy_n(point, nDim, points.data() + (points.getNrows() - 1) * nDim);
+    indices.push_back(index);
+    hashes.push_back(hash);
+  }
+
+  /// @brief Number of points.
+  size_t size() const { return indices.size(); }
+
+  base::DataMatrix points;       ///< The points, one per row.
+  std::vector<size_t> indices;   ///< Index of every point in the block.
+  std::vector<uint64_t> hashes;  ///< Hash of every point.
+  std::vector<double> values;    ///< Their values (m per point), filled by the evaluation.
+  size_t nOutputs = 0;           ///< Number of values per point m.
+};
+
+}  // namespace misc
+}  // namespace combigrid
+}  // namespace sgpp
