+BOOST_AUTO_TEST_CASE(every_form_evaluates_blocks_points_and_matrices_alike) {
+  const std::vector<SourceFunc> forms{
+      SourceFunc(std::function<double(const DataVector&)>(scalarFunc)),  // std::function
+      SourceFunc(&scalarFunc),                                           // function pointer
+      SourceFunc([](const DataVector& x) { return scalarFunc(x); }),     // lambda (inlined)
+      SourceFunc(SourceFunc::BatchFunc(scalarBatch))};                   // batch callable
+  BlockFixture fixture;
+  const std::vector<DataVector> points = fixture.expected();
+  DataMatrix matrix(points.size(), 4);
+  for (size_t p = 0; p < points.size(); p++) matrix.setRow(p, points[p]);
+
+  for (const SourceFunc& f : forms) {
+    std::vector<double> blockValues(points.size()), matrixValues(points.size());
+    f.evaluateBlock(fixture.block(), blockValues.data());
+    f.evaluate(matrix, matrixValues);
+    for (size_t p = 0; p < points.size(); p++) {
+      BOOST_CHECK_EQUAL(blockValues[p], scalarFunc(points[p]));
+      BOOST_CHECK_EQUAL(matrixValues[p], scalarFunc(points[p]));
+      BOOST_CHECK_EQUAL(f.evaluate(points[p]), scalarFunc(points[p]));
+    }
+  }
+
+  const VectorSourceFunc vector(VectorSourceFunc::BatchFunc(vectorBatch), N_OUTPUTS);
+  std::vector<double> values(points.size() * N_OUTPUTS), expected(N_OUTPUTS);
+  vector.evaluateBlock(fixture.block(), values.data());
+  for (size_t p = 0; p < points.size(); p++) {
+    vectorFunc(points[p], expected);
+    for (size_t k = 0; k < N_OUTPUTS; k++) {
+      BOOST_CHECK_EQUAL(values[p * N_OUTPUTS + k], expected[k]);
+    }
+  }
+}
