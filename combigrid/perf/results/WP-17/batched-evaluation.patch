+/**
+ * @brief Returns the number of points per row piece of the blocks of a tensor-product iteration
+ * with @p nRowNodes points per row: the whole row if it fits into a block, else
+ * @c constants::source_func_evaluation::MAX_BLOCK_POINTS (rows are split into pieces).
+ */
+inline GPCntType blockRowPieceLength(const GPCntType nRowNodes) {
+  return std::min<GPCntType>(nRowNodes, constants::source_func_evaluation::MAX_BLOCK_POINTS);
+}
+
+/**
+ * @brief Returns the number of outer dimensions of the blocks of a tensor-product iteration: as
+ * many of the iterated dimensions after the row dimension as fit into a block with whole rows
+ * (0 if a row does not fit).
+ * @param nNodes    Number of nodes per iterated dimension (@c nNodes[0]: the row dimension).
+ * @param nIterDims Number of iterated dimensions.
+ */
+inline size_t blockOuterDimsCnt(const GPCntType* const nNodes, const size_t nIterDims) {
+  size_t nPoints = nNodes[0];
+  size_t nOuterDims = 0;
+
+  while (1 + nOuterDims < nIterDims &&
+         nPoints * nNodes[1 + nOuterDims] <= constants::source_func_evaluation::MAX_BLOCK_POINTS) {
+    nPoints *= nNodes[1 + nOuterDims];
+    nOuterDims++;
+  }
+
+  return nOuterDims;
+}
+
+/**
+ * @brief Returns the number of rows of a block with @p nOuterDims outer dimensions.
+ * @param nNodes     Number of nodes per iterated dimension (@c nNodes[0]: the row dimension).
+ * @param nOuterDims Number of outer dimensions of the block (@ref blockOuterDimsCnt).
+ */
+inline size_t blockRowsCnt(const GPCntType* const nNodes, const size_t nOuterDims) {
+  size_t nRows = 1;
+
+  for (size_t j = 1; j <= nOuterDims; j++) {
+    nRows *= nNodes[j];
+  }
+
+  return nRows;
+}
+
+/**
+ * @brief Calls @p visit(point) for every point of @p block in its order, with @c point =
+ * @c block.point holding the coordinates of the point.
+ *
+ * Rows are short (often 2-4 points): unrolled (-funroll-loops), the row loop would start with a
+ * dispatch on the remainder, which costs more per row than it saves; hence `unroll 1`. The
+ * coordinates and indices are kept in locals, so that an opaque @p visit (a user function) costs
+ * no reloads of the block description.
+ */
+template <typename Visit>
+inline void forEachPointOfBlock(const PointBlock& block, Visit&& visit) {
+  assert(block.nOuterDims <= PointBlock::MAX_OUTER_DIMS);
+  assert(block.nRowNodes >= 1);
+
+  base::DataVector& point = block.point;
+  double* const coords = point.data();
+  double* const rowCoord = coords + block.rowDim;
+  const double* const rowNodes = block.rowNodes;
+  const double* const rowEnd = rowNodes + block.nRowNodes;
+  const size_t nOuterDims = block.nOuterDims;
+  std::array<GPCntType, PointBlock::MAX_OUTER_DIMS> idx{};
+
+  for (size_t j = 0; j < nOuterDims; j++) {
+    coords[block.outerDims[j]] = block.outerNodes[j][0];
+  }
+
+  while (true) {
+    for (const double* node = rowNodes; node != rowEnd; node++) {
+      *rowCoord = *node;
+      visit(static_cast<const base::DataVector&>(point));
+    }
+
+    // Next row: increments the first outer dimension that does not wrap around
+    size_t j = 0;
+
+    for (; j < nOuterDims; j++) {
+      if (++idx[j] < block.nOuterNodes[j]) {
+        coords[block.outerDims[j]] = block.outerNodes[j][idx[j]];
+        break;
+      }
+
+      idx[j] = 0;
+      coords[block.outerDims[j]] = block.outerNodes[j][0];
+    }
+
+    if (j == nOuterDims) {
+      return;
+    }
+  }
+}
