+BOOST_AUTO_TEST_CASE(batch_callable_receives_blocks_of_at_most_max_points) {
+  std::atomic<size_t> calls{0}, points{0}, largest{0};
+  const SourceFunc f(SourceFunc::BatchFunc([&](const DataMatrix& m, const std::span<double> v) {
+    calls++;
+    points += m.getNrows();
+    size_t seen = largest.load();
+    while (m.getNrows() > seen && !largest.compare_exchange_weak(seen, m.getNrows())) {
+    }
+    scalarBatch(m, v);
+  }));
+
+  for (const auto& [nDim, maxLvl] : std::vector<std::pair<size_t, LvlType>>{{1, 9}, {5, 4}}) {
+    calls = points = largest = 0;
+    CompleteSGGenInstr genInstr(maxLvl, nDim);
+    genInstr.setLvl2GPCntFunc(sgpp::combigrid::doublingLvl2GPCntFunction);
+    genInstr.setBoundaryLevelOffset(0);
+    const DeltasSparseGrid dsg(genInstr);
+    sgpp::combigrid::quadrature(f, dsg);
+
+    size_t nGP = 0;
+    for (const auto& tgData : dsg) nGP += tgData.tensorGrid.nGP();
+    BOOST_CHECK_EQUAL(points.load(), nGP);             // every point once
+    BOOST_CHECK_LE(largest.load(), MAX_BLOCK_POINTS);  // at most one block per call
+    BOOST_CHECK_LT(calls.load(), nGP);                 // several points per call
+  }
+}
