+namespace sgpp {
+namespace combigrid {
+namespace misc {
+
+namespace {
+
+/// Evaluation callback of the adaptive policy (SourceFuncCache::evaluateAdaptive).
+void evaluateInner(const void* evaluator, const base::DataVector& point,
+                   const std::span<double> values) {
+  static_cast<const SourceFuncEvaluator*>(evaluator)->evaluate(point, values.data());
+}
+
+}  // namespace
+
+AdaptiveCachedSourceFuncEvaluator::AdaptiveCachedSourceFuncEvaluator(
+    std::unique_ptr<SourceFuncEvaluator> inner, std::shared_ptr<SourceFuncCache> cache,
+    const size_t nOutputs)
+    : inner_(std::move(inner)),
+      cache_(std::move(cache)),
+      controller_(cache_->adaptiveController()),
+      nOutputs_(nOutputs) {}
+
+std::unique_ptr<SourceFuncEvaluator> AdaptiveCachedSourceFuncEvaluator::clone() const {
+  return std::make_unique<AdaptiveCachedSourceFuncEvaluator>(inner_->clone(), cache_, nOutputs_);
+}
+
+void AdaptiveCachedSourceFuncEvaluator::evaluate(const base::DataVector& point,
+                                                 double* const values) const {
+  const AdaptiveCacheMode mode = controller_->mode();
+  BoostPointValueTable* const table = this->table(mode, point.size());
+  if (table == nullptr) {
+    inner_->evaluate(point, values);  // mode None (its only cost: the load and test)
+    return;
+  }
+
+  evaluateCached(*table, mode, point, values);
+}
+
+void AdaptiveCachedSourceFuncEvaluator::evaluateBlock(const PointBlock& block,
+                                                      double* const values) const {
+  const AdaptiveCacheMode mode = controller_->mode();
+  BoostPointValueTable* const table = this->table(mode, block.point.size());
+  if (table == nullptr) {
+    inner_->evaluateBlock(block, values);
+    return;
+  }
+
+  double* out = values;
+  forEachPointOfBlock(block, [&](const base::DataVector& point) {
+    evaluateCached(*table, mode, point, out);
+    out += nOutputs_;
+  });
+}
+
+void AdaptiveCachedSourceFuncEvaluator::evaluatePoints(const base::DataMatrix& points,
+                                                       double* const values) const {
+  const AdaptiveCacheMode mode = controller_->mode();
+  BoostPointValueTable* const table = this->table(mode, points.getNcols());
+  if (table == nullptr) {
+    inner_->evaluatePoints(points, values);
+    return;
+  }
+
+  base::DataVector point(points.getNcols());
+  for (size_t row = 0; row < points.getNrows(); row++) {
+    points.getRow(row, point);
+    evaluateCached(*table, mode, point, values + row * nOutputs_);
+  }
+}
+
+BoostPointValueTable* AdaptiveCachedSourceFuncEvaluator::table(const AdaptiveCacheMode mode,
+                                                               const size_t nDim) const {
+  return (mode == AdaptiveCacheMode::None) ? nullptr : cache_->table(nDim);
+}
+
+void AdaptiveCachedSourceFuncEvaluator::evaluateCached(BoostPointValueTable& table,
+                                                       const AdaptiveCacheMode mode,
+                                                       const base::DataVector& point,
+                                                       double* const values) const {
+  // Memory hits inline, as with the other policies; misses and timed points out of line.
+  const uint64_t hash = BoostPointValueTable::hash(point.data(), point.size());
+  const bool sampled = controller_->sampled(hash);
+  if (!sampled && table.find(point.data(), hash, values)) {
+    return;
+  }
+  cache_->evaluateAdaptive(table, mode, hash, sampled, point, std::span<double>(values, nOutputs_),
+                           &evaluateInner, inner_.get());
+}
+
+}  // namespace misc
+}  // namespace combigrid
+}  // namespace sgpp
