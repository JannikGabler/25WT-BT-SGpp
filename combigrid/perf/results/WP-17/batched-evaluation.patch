+}  // namespace sgpp
diff --git a/combigrid/src/sgpp/combigrid/miscellaneous/source_function_evaluation/point_block.hpp b/combigrid/src/sgpp/combigrid/miscellaneous/source_function_evaluation/point_block.hpp
new file mode 100644
index 000000000..68e94b33f
--- /dev/null
+++ b/combigrid/src/sgpp/combigrid/miscellaneous/source_function_evaluation/point_block.hpp
@@ -0,0 +1,161 @@
+// Copyright (C) 2008-today The SG++ project
+// This file is part of the SG++ project. For conditions of distribution and
+// use, please see the copyright notice provided with SG++ or at
+// sgpp.sparsegrids.org
+
+/**
+ * @file point_block.hpp
+ * @brief Block of grid points evaluated with one call of a source function (@c PointBlock) and
+ * the iteration over its points (@c forEachPointOfBlock).
+ */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cassert>
+#include <cstddef>
+#include <sgpp/base/datatypes/DataVector.hpp>
+#include <sgpp/combigrid/constants.hpp>
+#include <sgpp/combigrid/type_defs.hpp>
+
+namespace sgpp {
+namespace combigrid {
+namespace misc {
+
+/**
+ * @brief A block of grid points: the tensor product of the nodes of a row dimension (fastest)
+ * and of up to @ref MAX_OUTER_DIMS outer dimensions, all other coordinates fixed.
+ *
+ * The operator kernels describe consecutive rows of a tensor grid this way and pass the block to
+ * the source function in one call, which evaluates its points in the order of the tensor grid
+ * (row dimension fastest, then the outer dimensions in their order). The coordinates of the
+ * block dimensions are written into @ref point by the evaluation (on return they are
+ * unspecified); the other coordinates of @ref point are the ones of every point of the block.
+ * The node arrays are those of the kernels, so a block costs no copy of points.
+ */
+struct PointBlock {
+  /// @brief Maximum number of outer dimensions: each has at least two nodes, so a block of at
+  /// most @c constants::source_func_evaluation::MAX_BLOCK_POINTS points has at most
+  /// log2(MAX_BLOCK_POINTS) of them.
+  static constexpr size_t MAX_OUTER_DIMS =
+      std::bit_width(constants::source_func_evaluation::MAX_BLOCK_POINTS) - 1;
+
+  /// @brief Point (all coordinates; the ones of the block dimensions are overwritten).
+  base::DataVector& point;
+  size_t rowDim;                    ///< Row dimension (the fastest one).
+  const double* rowNodes;           ///< Coordinates of the row dimension (@ref nRowNodes).
+  GPCntType nRowNodes;              ///< Number of points per row (at least 1).
+  size_t nOuterDims;                ///< Number of outer dimensions (0: a single row).
+  const size_t* outerDims;          ///< Outer dimensions (@ref nOuterDims).
+  const GPCntType* nOuterNodes;     ///< Number of nodes of the outer dimensions (each at least 2).
+  const double* const* outerNodes;  ///< Coordinates of the outer dimensions.
+
+  /// @brief Number of points of the block.
+  size_t nPoints() const {
+    size_t n = nRowNodes;
+    for (size_t j = 0; j < nOuterDims; j++) {
+      n *= nOuterNodes[j];
+    }
+    return n;
+  }
+};
