+BOOST_AUTO_TEST_CASE(operators_give_bitwise_equal_results_for_every_form) {
+  withThreads(1, []() {
+    forEachProblem([](const Problem& problem) {
+      const std::vector<double> reference =
+          problem.run(SourceFunc(std::function<double(const DataVector&)>(scalarFunc)));
+      BOOST_CHECK(bitwiseEqual(problem.run(SourceFunc(&scalarFunc)), reference));
+      BOOST_CHECK(bitwiseEqual(
+          problem.run(SourceFunc([](const DataVector& x) { return scalarFunc(x); })), reference));
+      BOOST_CHECK(
+          bitwiseEqual(problem.run(SourceFunc(SourceFunc::BatchFunc(scalarBatch))), reference));
+
+      const std::vector<double> vectorReference = problem.run(VectorSourceFunc(
+          std::function<void(const DataVector&, std::span<double>)>(vectorFunc), N_OUTPUTS));
+      BOOST_CHECK(bitwiseEqual(
+          problem.run(VectorSourceFunc(VectorSourceFunc::BatchFunc(vectorBatch), N_OUTPUTS)),
+          vectorReference));
+      BOOST_CHECK(
+          bitwiseEqual(problem.run(VectorSourceFunc(&vectorFunc, N_OUTPUTS)), vectorReference));
+
+      if (!cacheAvailable()) return;
+      const CachedSourceFunc cachedBatch{SourceFunc::BatchFunc(scalarBatch)};
+      BOOST_CHECK(bitwiseEqual(problem.run(cachedBatch), reference));  // misses
+      BOOST_CHECK(bitwiseEqual(problem.run(cachedBatch), reference));  // hits
+      const CachedVectorSourceFunc cachedVector(VectorSourceFunc::BatchFunc(vectorBatch),
+                                                N_OUTPUTS);
+      BOOST_CHECK(bitwiseEqual(problem.run(cachedVector), vectorReference));
+      BOOST_CHECK(bitwiseEqual(problem.run(cachedVector), vectorReference));
+      const CachedSourceFunc adaptive(SourceFunc::BatchFunc(scalarBatch),
+                                      SourceFuncCacheConfig{.policy = CachePolicy::Adaptive});
+      BOOST_CHECK(bitwiseEqual(problem.run(adaptive), reference));
+      BOOST_CHECK(bitwiseEqual(problem.run(adaptive), reference));
+    });
+  });
+}
