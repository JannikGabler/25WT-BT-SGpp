+/**
+ * @file source_func_evaluator.hpp
+ * @brief Type-erased evaluation of a source function (@c misc::SourceFuncEvaluator).
+ */
+#pragma once
+
+#include <cstddef>
+#include <memory>
+#include <sgpp/base/datatypes/DataMatrix.hpp>
+#include <sgpp/base/datatypes/DataVector.hpp>
+#include <sgpp/combigrid/miscellaneous/source_function_evaluation/point_block.hpp>
+
+namespace sgpp {
+namespace combigrid {
+namespace misc {
+
+/**
+ * @brief The callable inside a @c SourceFunc / @c VectorSourceFunc: evaluates the function with
+ * m values per point at one point, at the points of a @c PointBlock or at the rows of a matrix.
+ *
+ * Built once when the source function is constructed: from a per-point callable
+ * (@c PointwiseSourceFuncEvaluator, which inlines the callable into its loop over a block), from a
+ * batch callable (@c BatchSourceFuncEvaluator) or around another evaluator (the caches). The
+ * operators evaluate blocks only, so the type-erased call is paid once per block, not per point.
+ * Values are point-major (m per point).
+ *
+ * The methods are const and may be called concurrently (the operators call them from all
+ * threads); an evaluator that keeps state must synchronize it.
+ */
+class SourceFuncEvaluator {
+ public:
+  virtual ~SourceFuncEvaluator() = default;
+
+  /// @brief Returns a copy (with its own copy of the callable; caches stay shared).
+  virtual std::unique_ptr<SourceFuncEvaluator> clone() const = 0;
+
+  /**
+   * @brief Evaluates at one point.
+   * @param point  Point in problem coordinates.
+   * @param values Output: the m values.
+   */
+  virtual void evaluate(const base::DataVector& point, double* values) const = 0;
+
+  /**
+   * @brief Evaluates at the points of a block (see @c PointBlock).
+   * @param block  Block (its point's block coordinates are overwritten).
+   * @param values Output: the m values of every point of the block, point-major.
+   */
+  virtual void evaluateBlock(const PointBlock& block, double* values) const = 0;
+
+  /**
+   * @brief Evaluates at the rows of @p points.
+   * @param points One point per row (problem coordinates).
+   * @param values Output: the m values of every row, row-major.
+   */
+  virtual void evaluatePoints(const base::DataMatrix& points, double* values) const = 0;
+
+ protected:
+  SourceFuncEvaluator() = default;
+  SourceFuncEvaluator(const SourceFuncEvaluator&) = default;
+  SourceFuncEvaluator& operator=(const SourceFuncEvaluator&) = default;
+};
+
+}  // namespace misc
+}  // namespace combigrid
+}  // namespace sgpp
