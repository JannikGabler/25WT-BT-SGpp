+
+/**
+ * @brief Evaluator of a callable that takes many points at once:
+ * @c void(const base::DataMatrix& points, std::span<double> values), one point per row of
+ * @c points, m values per point written to @c values (row-major).
+ *
+ * A block is copied into a matrix (per thread, reused) and passed in one call; a single point is
+ * a matrix with one row.
+ */
+class BatchSourceFuncEvaluator final : public SourceFuncEvaluator {
+ public:
+  /// @brief Type of the batch callable.
+  using BatchFunc = std::function<void(const base::DataMatrix&, std::span<double>)>;
+
+  /**
+   * @brief Wraps @p func.
+   * @param func     Batch callable.
+   * @param nOutputs Number of values per point m.
+   */
+  BatchSourceFuncEvaluator(BatchFunc func, size_t nOutputs);
+
+  std::unique_ptr<SourceFuncEvaluator> clone() const override;
+
+  void evaluate(const base::DataVector& point, double* values) const override;
+
+  void evaluateBlock(const PointBlock& block, double* values) const override;
+
+  void evaluatePoints(const base::DataMatrix& points, double* values) const override;
+
+ private:
+  BatchFunc func_;   ///< The batch callable.
+  size_t nOutputs_;  ///< Number of values per point m.
+};
+
