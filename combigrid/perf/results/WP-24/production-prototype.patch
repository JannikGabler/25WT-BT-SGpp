+
+/**
+ * @file vector_source_function.hpp
+ * @brief WP-24 PROTOTYPE (reverted after the measurement): wrapper for vector-valued black-box
+ * functions @f$f: \mathbb{R}^d \to \mathbb{R}^m@f$.
+ */
+#pragma once
+
+#include <functional>
+#include <sgpp/base/datatypes/DataVector.hpp>
+#include <sgpp/combigrid/type_defs.hpp>
+#include <span>
+
+namespace sgpp {
+namespace combigrid {
+
+/**
+ * @brief Adapter around a user-supplied function @f$f : \mathbb{R}^d \to \mathbb{R}^m@f$ with a
+ * runtime number of outputs m; the vector counterpart of @c SourceFunc.
+ */
+class VectorSourceFunc {
+ public:
+  /**
+   * @brief Wraps the provided callable.
+   * @param func     Callable writing the m values at a point (problem coordinates) to its
+   *                 second argument (size m).
+   * @param nOutputs Number of outputs m (at least 1).
+   */
+  VectorSourceFunc(std::function<void(const base::DataVector&, std::span<double>)> func,
+                   size_t nOutputs);
+
+  /// @brief Number of outputs m.
+  size_t nOutputs() const;
+
+  /**
+   * @brief Evaluates the function at @p point in problem coordinates.
+   * @param point Evaluation point in problem coordinates.
+   * @param out   The m function values (size m).
+   */
+  void evaluate(const base::DataVector& point, std::span<double> out) const;
+
+  /**
+   * @brief Evaluates the function on a normalized point in @f$[0,1]^d@f$, mapping it onto
+   * @p area first (in place, see @c SourceFunc::evaluateNormalizedInPlace).
+   */
+  void evaluateNormalizedInPlace(base::DataVector& point, const HyperCubeArea& area,
+                                 std::span<double> out) const;
+
+ private:
+  std::function<void(const base::DataVector&, std::span<double>)> func;  ///< Wrapped callable.
+  size_t nOutputs_;                                                       ///< m.
+};
+
+}  // namespace combigrid
+}  // namespace sgpp
