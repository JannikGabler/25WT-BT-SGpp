+bool InterpolationMethod::hasTrivialResult(const double pos, const std::vector<double>& nodes,
+                                           const std::vector<double>& values, const size_t m,
+                                           double* const out) const {
+  const size_t nNodes = nodes.size();
+
+  if (nNodes == 0) {
+    std::fill_n(out, m, 0.0);
+    return true;
+  } else if (nNodes == 1) {
+    std::copy_n(values.data(), m, out);
+    return true;
+  } else if (nNodes == 2) {
+    for (size_t k = 0; k < m; k++) {
+      out[k] = (values[m + k] - values[k]) / (nodes[1] - nodes[0]) * (pos - nodes[0]) + values[k];
+    }
+    return true;
+  }
+
+  for (size_t i = 0; i < nNodes; i++) {
+    if (tools::nearlyEqual(pos, nodes[i])) {
+      std::copy_n(values.data() + i * m, m, out);
+      return true;
+    }
+  }
+
+  return false;
+}
