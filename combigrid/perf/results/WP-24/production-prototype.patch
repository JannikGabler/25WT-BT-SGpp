new file mode 100644
index 000000000..3bc61eb99
--- /dev/null
+++ b/combigrid/src/sgpp/combigrid/tools/operators/source_function_values.hpp
@@ -0,0 +1,142 @@
+// Copyright (C) 2008-today The SG++ project
+// This file is part of the SG++ project. For conditions of distribution and
+// use, please see the copyright notice provided with SG++ or at
+// sgpp.sparsegrids.org
+
+/**
+ * @file source_function_values.hpp
+ * @brief WP-24 PROTOTYPE (reverted after the measurement): value types of the generic operator
+ * kernels ("template on the value type").
+ *
+ * The operator kernels are written once as templates over a value type, which evaluates the
+ * source function at a grid point and accumulates weighted values: @ref ScalarValues (today's
+ * @c double, the scalar instantiation compiles to today's kernels) and @ref VectorValues (m
+ * values per grid point, runtime m, accumulators in per-thread buffers). Both are small views
+ * that are passed by value, so that the kernels hold their data in registers across the opaque
+ * source-function calls.
+ */
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <sgpp/base/datatypes/DataVector.hpp>
+#include <sgpp/combigrid/functions/source_functions/source_function.hpp>
+#include <sgpp/combigrid/functions/source_functions/vector_source_function.hpp>
+#include <sgpp/combigrid/operators/global_interpolation/methods/interpolation_method.hpp>
+#include <sgpp/combigrid/type_defs.hpp>
+#include <span>
+#include <vector>
+
+namespace sgpp {
+namespace combigrid {
+namespace tools {
+
+/// @brief Value type "scalar" (today's @c double).
+class ScalarValues {
+ public:
+  using Acc = double;  ///< Accumulator of the values of one output.
+
+  explicit ScalarValues(const SourceFunc& sourceFunc) : sourceFunc(sourceFunc) {}
+
+  static constexpr size_t nOutputs() { return 1; }
+
+  Acc zeroRow() const { return 0.0; }
+  Acc zeroResult() const { return 0.0; }
+
+  double evaluate(const base::DataVector& gp) const { return sourceFunc.evaluate(gp); }
+
+  void evaluateNormalizedInPlace(base::DataVector& gp, const HyperCubeArea& area,
+                                 double* const out) const {
+    *out = sourceFunc.evaluateNormalizedInPlace(gp, area);
+  }
+
+  static void addScaled(Acc& acc, const double weight, const double value) {
+    acc += weight * value;
+  }
+
+  static void store(const Acc& acc, double* const out) { *out = acc; }
+
+  static void interpolate1D(const InterpolationMethod& method, const double pos,
+                            const std::vector<double>& nodes, const std::vector<double>& values,
+                            double* const out) {
+    *out = method.interpolate(pos, nodes, values);
+  }
+
+ private:
+  const SourceFunc& sourceFunc;
+};
+
+/**
+ * @brief Per-thread buffers of @ref VectorValues (m doubles each).
+ */
+struct VectorValueBuffers {
+  explicit VectorValueBuffers(const size_t nOutputs)
+      : values(nOutputs), rowSum(nOutputs), result(nOutputs) {}
+
+  std::vector<double> values;  ///< Values at the current grid point.
+  std::vector<double> rowSum;  ///< Row sums (quadrature).
+  std::vector<double> result;  ///< Result accumulators.
+};
+
+/// @brief Value type "m values per grid point" (runtime m).
+class VectorValues {
+ public:
+  /// @brief Accumulators of the m outputs (in a @ref VectorValueBuffers).
+  struct Acc {
+    double* p;
+  };
+
+  VectorValues(const VectorSourceFunc& sourceFunc, VectorValueBuffers& buffers)
+      : sourceFunc(&sourceFunc),
+        m(sourceFunc.nOutputs()),
+        values(buffers.values.data()),
+        rowSum(buffers.rowSum.data()),
+        result(buffers.result.data()) {}
+
+  size_t nOutputs() const { return m; }
+
+  Acc zeroRow() const {
+    std::fill_n(rowSum, m, 0.0);
+    return {rowSum};
+  }
+  Acc zeroResult() const {
+    std::fill_n(result, m, 0.0);
+    return {result};
+  }
+
+  const double* evaluate(const base::DataVector& gp) const {
+    sourceFunc->evaluate(gp, std::span<double>(values, m));
+    return values;
+  }
+
+  void evaluateNormalizedInPlace(base::DataVector& gp, const HyperCubeArea& area,
+                                 double* const out) const {
+    sourceFunc->evaluateNormalizedInPlace(gp, area, std::span<double>(out, m));
+  }
+
+  void addScaled(const Acc acc, const double weight, const double* const vals) const {
+    for (size_t k = 0; k < m; k++) acc.p[k] += weight * vals[k];
+  }
+  void addScaled(const Acc acc, const double weight, const Acc vals) const {
+    addScaled(acc, weight, vals.p);
+  }
+
+  void store(const Acc acc, double* const out) const { std::copy_n(acc.p, m, out); }
+
+  void interpolate1D(const InterpolationMethod& method, const double pos,
+                     const std::vector<double>& nodes, const std::vector<double>& vals,
+                     double* const out) const {
+    method.interpolate(pos, nodes, vals, m, out);
+  }
+
+ private:
+  const VectorSourceFunc* sourceFunc;
+  size_t m;
+  double* values;
+  double* rowSum;
+  double* result;
+};
+
+}  // namespace tools
+}  // namespace combigrid
+}  // namespace sgpp
diff --git a/combigrid/tests/operators/vector_source_function_prototype_test.cpp b/combigrid/tests/operators/vector_source_function_prototype_test.cpp
new file mode 100644
index 000000000..f708e257b
--- /dev/null
+++ b/combigrid/tests/operators/vector_source_function_prototype_test.cpp
@@ -0,0 +1,129 @@
+// Copyright (C) 2008-today The SG++ project
+// This file is part of the SG++ project. For conditions of distribution and
+// use, please see the copyright notice provided with SG++ or at
+// sgpp.sparsegrids.org
+
+/**
+ * @file vector_source_function_prototype_test.cpp
+ * @brief WP-24 PROTOTYPE (reverted after the measurement): component k of a vector-valued
+ * quadrature / global interpolation equals the scalar run of component k (within round-off: the
+ * compiler's FMA contraction may differ between the instantiations, and the thread reductions
+ * combine in a different order).
+ */
+
+#define BOOST_TEST_DYN_LINK
+
+#include <boost/test/unit_test.hpp>
+
+#include <cmath>
+#include <sgpp/base/datatypes/DataVector.hpp>
+#include <sgpp/combigrid/functions/level_to_grid_point_count_functions/level_to_grid_point_count_functions.hpp>
+#include <sgpp/combigrid/functions/node_generation_functions/getter/clenshaw_curtis_node_generation_function_getter.hpp>
+#include <sgpp/combigrid/functions/node_generation_functions/getter/equidistant_node_generation_function_getter.hpp>
+#include <sgpp/combigrid/functions/node_generation_functions/getter/first_type_chebyshev_node_generation_function_getter.hpp>
+#include <sgpp/combigrid/functions/source_functions/source_function.hpp>
+#include <sgpp/combigrid/functions/source_functions/vector_source_function.hpp>
+#include <sgpp/combigrid/grids/sparse_grid.hpp>
+#include <sgpp/combigrid/operators/global_interpolation/global_interpolation.hpp>
+#include <sgpp/combigrid/operators/quadrature/quadrature.hpp>
+#include <sgpp/combigrid/sparse_grid_generation_instructions/complete_sg_gen_instruction.hpp>
+#include <sgpp/combigrid/type_defs.hpp>
+#include <span>
+#include <vector>
+
+using sgpp::base::DataVector;
+using sgpp::combigrid::CompleteSGGenInstr;
+using sgpp::combigrid::HyperCubeArea;
+using sgpp::combigrid::LvlType;
+using sgpp::combigrid::NodeGenFunc;
+using sgpp::combigrid::SourceFunc;
+using sgpp::combigrid::SparseGrid;
+using sgpp::combigrid::VectorSourceFunc;
+
+namespace {
+
+constexpr size_t N_OUTPUTS = 3;
+
+/// Output k: prod_i sin(x_i + 0.3 k) + k.
+double component(const DataVector& x, const size_t k) {
+  double result = 1.0;
+  for (size_t i = 0; i < x.size(); i++) result *= std::sin(x[i] + 0.3 * static_cast<double>(k));
+  return result + static_cast<double>(k);
+}
+
+VectorSourceFunc vectorFunc() {
+  return VectorSourceFunc(
+      [](const DataVector& x, std::span<double> out) {
+        for (size_t k = 0; k < out.size(); k++) out[k] = component(x, k);
+      },
+      N_OUTPUTS);
+}
+
+SourceFunc scalarFunc(const size_t k) {
+  return SourceFunc([k](const DataVector& x) { return component(x, k); });
+}
+
+HyperCubeArea shiftedDomain(const size_t nDim) {
+  HyperCubeArea domain;
+  for (size_t i = 0; i < nDim; i++) domain.emplace_back(-0.5 + 0.1 * i, 1.0 + 0.2 * i);
+  return domain;
+}
+
+/// All configurations: node families, boundary offsets 0/1, d = 1..4.
+template <typename Check>
+void forEachConfig(const std::vector<NodeGenFunc*>& nodeGenFuncs, Check check) {
+  for (NodeGenFunc* nodeGenFunc : nodeGenFuncs) {
+    for (const LvlType boundary : {0u, 1u}) {
+      for (size_t nDim = 1; nDim <= 4; nDim++) {
+        CompleteSGGenInstr genInstr(static_cast<LvlType>(7 - nDim), nDim);
+        genInstr.setDomain(shiftedDomain(nDim));
+        genInstr.setNodeGenFunc(nodeGenFunc);
+        genInstr.setLvl2GPCntFunc(sgpp::combigrid::doublingLvl2GPCntFunction);
+        genInstr.setBoundaryLevelOffset(boundary);
+        const SparseGrid sg(genInstr);
+        check(sg, nDim);
+      }
+    }
+  }
+}
+
+}  // namespace
+
+BOOST_AUTO_TEST_SUITE(vector_source_function_prototype)
+
+BOOST_AUTO_TEST_CASE(quadrature_component_equals_scalar) {
+  // (First-kind Chebyshev nodes have no quadrature rule)
+  const std::vector<NodeGenFunc*> nodeGenFuncs = {sgpp::combigrid::getEquidistantNodeGenFunc(),
+                                                  sgpp::combigrid::getClenshawCurtisNodeGenFunc()};
+  forEachConfig(nodeGenFuncs, [](const SparseGrid& sg, size_t) {
+    std::vector<double> result(N_OUTPUTS);
+    sgpp::combigrid::quadrature(vectorFunc(), sg, result);
+    for (size_t k = 0; k < N_OUTPUTS; k++) {
+      const double scalar = sgpp::combigrid::quadrature(scalarFunc(k), sg);
+      BOOST_CHECK_CLOSE_FRACTION(result[k], scalar, 1e-12);
+    }
+  });
+}
+
+BOOST_AUTO_TEST_CASE(interpolation_component_equals_scalar) {
+  const std::vector<NodeGenFunc*> nodeGenFuncs = {
+      sgpp::combigrid::getEquidistantNodeGenFunc(), sgpp::combigrid::getClenshawCurtisNodeGenFunc(),
+      sgpp::combigrid::getFirstTypeChebyshevNodeGenFunc()};
+  forEachConfig(nodeGenFuncs, [](const SparseGrid& sg, const size_t nDim) {
+    const HyperCubeArea domain = shiftedDomain(nDim);
+    for (const double t : {0.0, 0.137, 0.5, 0.91, 1.0}) {
+      DataVector point(nDim);
+      for (size_t i = 0; i < nDim; i++) {
+        point[i] = domain[i].first + t * (domain[i].second - domain[i].first);
+      }
+      std::vector<double> result(N_OUTPUTS);
+      sgpp::combigrid::interpolate(vectorFunc(), point, sg, result);
+      for (size_t k = 0; k < N_OUTPUTS; k++) {
+        const double scalar = sgpp::combigrid::interpolate(scalarFunc(k), point, sg);
+        BOOST_CHECK_SMALL(result[k] - scalar, 1e-10 * (1.0 + std::abs(scalar)));
+      }
+    }
+  });
+}
+
+BOOST_AUTO_TEST_SUITE_END()
