+SourceFunc::SourceFunc(std::function<double(const base::DataVector&)> func,
+                       std::shared_ptr<misc::SourceFuncCache> cache)
+    : func(std::move(func)), cache(std::move(cache)) {}
+
+double SourceFunc::evaluate(const base::DataVector& point) const {
+  if (cache != nullptr) [[unlikely]] {
+    return evaluateCached(point);
+  }
+  return func(point);
+}
+
+double SourceFunc::evaluateCached(const base::DataVector& point) const {
+  double value;
+  if (cache->find(point, value)) {
+    return value;
+  }
+  value = func(point);
+  cache->insert(point, value);
+  return value;
+}
+
+void SourceFunc::finishOperatorCall() const {
+  if (cache != nullptr) [[unlikely]] {
+    cache->flush();
+  }
+}
 
